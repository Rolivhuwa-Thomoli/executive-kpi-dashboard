-- Integration measures for the Executive KPI Dashboard
-- Add one at a time: right-click marketing_leads_clean -> New measure

-- Count of cleaned leads
Total Leads = COUNTROWS ( marketing_leads_clean )

-- Total monthly budget behind those leads
Lead Budget = SUM ( marketing_leads_clean[monthly_budget] )

-- Revenue per lead: how much trade does each marketing contact sit alongside?
Revenue per Lead =
DIVIDE ( [Total Revenue], [Total Leads] )

-- Attention Gap: budget share minus revenue share
-- Positive = we overspend attention here relative to the trade it generates
Attention Gap =
DIVIDE ( [Lead Budget], CALCULATE ( [Lead Budget], ALL ( ProvinceDim ) ) )
    - DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], ALL ( ProvinceDim ) ) )

-- Leads with missing email (data-quality card on Page 1)
Leads Missing Email =
COUNTROWS ( FILTER ( marketing_leads_clean, ISBLANK ( marketing_leads_clean[email] ) ) )

-- ---------------------------------------------------------------------------
